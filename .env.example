# Trimble ID (public PKCE client). Copy to .env.local for Vite, or set the same
# names in the Vercel project. Redirect URLs may be omitted: the app then uses
# window.location.origin + /callback and /logout-callback.
VITE_CONFIGURATION_ENDPOINT=https://id.trimble.com/.well-known/openid-configuration
VITE_CLIENT_ID=434d69fd-a3ee-49a8-b9c9-a4471329cf7c
VITE_SCOPES=Clash-Helper
# VITE_REDIRECT_URL=http://localhost:5173/callback
# VITE_LOGOUT_REDIRECT_URL=http://localhost:5173/logout-callback
